# Copy this file to .env and edit it. .env is gitignored; never commit it.
# Every value below is a safe placeholder.

# ---------------------------------------------------------------------------
# LLM provider. Any OpenAI-compatible API works.
# LLM_BASE_URL and LLM_MODEL are required. LLM_API_KEY is only needed by hosted
# providers; local servers (Ollama, LM Studio) work without it.
# ---------------------------------------------------------------------------

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-replace-me
# LLM_MODEL=openai/gpt-4o-mini

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_replace-me
# LLM_MODEL=llama-3.1-8b-instant

# Ollama on the host machine, backend running locally (no Docker).
# LLM_MODEL must name a model you have pulled (`ollama list` shows them).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Ollama on the host machine, backend running in Docker
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2

# LM Studio (use host.docker.internal instead of localhost when in Docker)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=the-model-id-shown-in-lm-studio

# ---------------------------------------------------------------------------
# Optional model settings
# ---------------------------------------------------------------------------

# Turns on image attachments (Stage 3). Set it by hand: it cannot be detected.
LLM_SUPPORTS_VISION=false

# Replaces the built-in system prompt. Leave empty to use the default.
# For several lines use a double-quoted value with \n, for example:
# LLM_SYSTEM_PROMPT="You are a pirate tutor who explains Python.\nAlways reply in Markdown and keep answers short."
LLM_SYSTEM_PROMPT=

LLM_TEMPERATURE=0.7

# Seconds to wait for the model before giving up (when streaming: for each next chunk).
LLM_TIMEOUT_SECONDS=120

# The model's context window in tokens. Only used for the context-size warning
# in the UI. Leave empty to turn the warning off.
LLM_CONTEXT_WINDOW=128000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Host ports used by Docker Compose. If you change BACKEND_PORT, also update
# API_BASE_URL in frontend/config.js. If you change FRONTEND_PORT, update CORS_ORIGINS.
BACKEND_PORT=6662
FRONTEND_PORT=6661

# Comma-separated browser origins allowed to call the backend. Never use *.
CORS_ORIGINS=http://localhost:6661,http://127.0.0.1:6661

# Largest image upload allowed, in MB (Stage 3).
MAX_IMAGE_MB=5

# Database for saved conversations (Stage 4). Relative paths start from the backend's
# working directory: backend/ when run locally, /app in Docker (a named volume). Uploaded
# images are stored in an uploads/ folder next to the SQLite file.
# DATABASE_URL=sqlite:///./data/chat.db
